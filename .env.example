# Copy this to .env and fill in your values

# App
APP_BASE_URL=http://localhost:5173

# PostgreSQL (database: commonauth)
# Option 1: full URL (no password: postgres://user@localhost:5432/commonauth?sslmode=disable)
# DATABASE_URL=postgres://postgres@localhost:5432/commonauth?sslmode=disable
# Option 2: individual vars (DB_NAME defaults to commonauth; leave DB_PASSWORD empty if none)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=commonauth
DB_SSLMODE=disable

# Admin User (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Email (SMTP) - leave empty to log emails to console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# Google OIDC
# Get from: https://console.cloud.google.com/apis/credentials
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback
OIDC_ISSUER_URL=https://accounts.google.com

# Okta SAML
# SAML_CERT_FILE=./keys/saml.crt
# SAML_KEY_FILE=./keys/saml.key
# SAML_IDP_METADATA_URL=https://your-okta-domain.okta.com/app/YOUR_APP_ID/sso/saml/metadata
# SAML_SP_BASE_URL=http://localhost:8080/api/auth
